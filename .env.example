# Change both values before exposing the app outside localhost.
APP_PASSWORD=change-me-admin-password
APP_SECRET=change-me-long-random-secret-used-to-encrypt-mail-passwords

# Default reading mode. You can change this later in the UI Settings modal.
# Allowed values: imap, api
READ_MODE=imap

# NotLetters IMAP defaults. You can change these in the UI Settings modal.
IMAP_HOST=imap.notletters.com
IMAP_PORT=993
IMAP_SECURE=true

# NotLetters API defaults. The API token is intentionally NOT stored here;
# paste it in the UI Settings modal so it can be encrypted in data/accounts.json.
NOTLETTERS_API_BASE_URL=https://api.notletters.com/v1

# Server bind settings.
HOST=127.0.0.1
PORT=3000

# Max messages loaded from a selected inbox. You can change this in the UI.
MESSAGE_LIMIT=50
